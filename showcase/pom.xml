<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dukehoff.decide</groupId>
        <artifactId>dukehoff-decide-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>dukehoff-decide-showcase</artifactId>
    <name>dukehoff-decide showcase</name>
    <description>Evaluation on public datasets: language models vs. trained classifiers, accuracy, calibration, deferral and latency.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- -Dshowcase.main=com.dukehoff.decide.showcase.Bench for the latency benchmark (profile modeljars) -->
        <showcase.main>com.dukehoff.decide.showcase.Showcase</showcase.main>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dukehoff.decide</groupId>
            <artifactId>dukehoff-decide-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dukehoff.decide</groupId>
            <artifactId>dukehoff-decide-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dukehoff.decide</groupId>
            <artifactId>dukehoff-decide-classifier</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dukehoff.decide</groupId>
            <artifactId>dukehoff-decide-embedding</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${showcase.main}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Dshowcase.engine=modeljars: models inside the JVM; needs JDK 25 and
             the Vector API module and native access in MAVEN_OPTS (see InJvm) -->
        <profile>
            <id>modeljars</id>
            <activation>
                <jdk>[25,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>25</maven.compiler.release>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.dukehoff.decide</groupId>
                    <artifactId>dukehoff-decide-modeljars</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.integrallis</groupId>
                    <artifactId>backend-native</artifactId>
                    <version>0.5.12</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>modeljars-sources</id>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/modeljars/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
